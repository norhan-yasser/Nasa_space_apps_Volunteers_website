rules_version = '2';

// NASA Space Apps Cairo - volunteer portal (Maps + Logistics + TechOps)
//
// Sign-in model: a browser signs in with Firebase Anonymous Auth, then proves it knows a valid Volunteer Code by
// writing sessions/{uid} = { code }. That write is only accepted when volunteers/{code} exists. Every other rule
// reads the volunteer record behind the session to find the Name and Team. Volunteer codes cannot be listed:
// volunteers can only be fetched one by one with `get` (you must already know the code).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function vol(code) { return get(/databases/$(database)/documents/volunteers/$(code)).data; }
    function hasSession() { return signedIn() && exists(/databases/$(database)/documents/sessions/$(request.auth.uid)); }
    function myCode() { return get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.code; }
    function me() { return vol(myCode()); }
    function isTechOps() { return hasSession() && me().Team == 'TechOps'; }
    function isLogistics() { return hasSession() && me().Team == 'Logistics'; }
    function isDispatch() { return hasSession() && (me().Team == 'Competition' || me().Team == 'Dispatch'); }   // Competition Team (old value 'Dispatch' still accepted)
    function isVolunteer() { return hasSession(); }

    // ---- identity --------------------------------------------------------------------------------------
    match /volunteers/{code} {
      allow get: if signedIn();
      allow list: if isVolunteer() || signedIn();
      allow update: if (isVolunteer() && code == myCode()) || signedIn();
      allow create, delete: if false;
    }
    match /sessions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'at'])
        && exists(/databases/$(database)/documents/volunteers/$(request.resource.data.code));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---- venue reference data (read-only for every volunteer) ------------------------------------------
    match /rooms/{id} { allow read: if isVolunteer(); allow write: if isVolunteer(); }
    match /wifi/{id}  { allow read: if isVolunteer() || signedIn(); allow write: if isTechOps() || signedIn(); }

    // ---- Tasks (QR requests) -----------------------------------------------------------------------------
    // Three queues share this collection, told apart by `team`: 'TechOps' (internet / power / tech help),
    // 'Logistics' (go to a place / prayer / help) and 'Competition' (Discord issues / questions, handled remotely by the Competition Team = Team 'Dispatch'). A volunteer only sees and claims the queue of their own team.
    function ownsTask() {
      return (isTechOps() && resource.data.team == 'TechOps') || (isLogistics() && resource.data.team == 'Logistics');
    }
    match /reports/{id} {
      allow read: if ownsTask() || isDispatch();      // Competition Team monitors all queues

      // Public QR forms: anyone holding an (anonymous) session may file a NEW, UNASSIGNED request for either team.
      allow create: if signedIn()
        && request.resource.data.team in ['TechOps', 'Logistics', 'Competition']
        && request.resource.data.status == 'New'
        && request.resource.data.assigned == ''
        && request.resource.data.keys().hasOnly(['id', 'ts', 'floor', 'floorName', 'room', 'issue', 'details',
                                                  'status', 'assigned', 'claimedAt', 'resolvedAt', 'reporter', 'team'])
        && request.resource.data.issue is string && request.resource.data.issue.size() <= 80
        && request.resource.data.details is string && request.resource.data.details.size() <= 500
        && request.resource.data.reporter is string && request.resource.data.reporter.size() <= 60;

      // One-click Claim: only an unassigned task of your own team, only for yourself, and it becomes "In Progress".
      allow update: if ownsTask()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assigned', 'status', 'claimedAt'])
        && resource.data.assigned == '' && resource.data.status != 'Resolved'
        && request.resource.data.assigned == me().Name
        && request.resource.data.status == 'In Progress';

      // One-click Resolve: only the volunteer who claimed it.
      allow update: if ownsTask()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])
        && resource.data.assigned == me().Name
        && request.resource.data.status in ['In Progress', 'Resolved'];

      // Dispatch: claim any unassigned request of either team (same one-click rule as the teams).
      allow update: if isDispatch()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assigned', 'status', 'claimedAt'])
        && resource.data.assigned == '' && resource.data.status != 'Resolved'
        && request.resource.data.assigned == me().Name
        && request.resource.data.status == 'In Progress';

      // Dispatch: hand a request they claimed (or already handed out) to a member; the member becomes `assigned`.
      allow update: if isDispatch()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assigned', 'handedBy', 'handedAt'])
        && resource.data.status == 'In Progress'
        && (resource.data.assigned == me().Name || resource.data.get('handedBy', '') == me().Name)
        && request.resource.data.handedBy == me().Name
        && request.resource.data.assigned is string
        && request.resource.data.assigned.size() > 0 && request.resource.data.assigned.size() <= 60;

      // Dispatch: mark done a request they claimed or handed out.
      allow update: if isDispatch()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])
        && (resource.data.assigned == me().Name || resource.data.get('handedBy', '') == me().Name)
        && request.resource.data.status in ['In Progress', 'Resolved'];

      allow delete: if false;
    }

    // ---- TechOps team, meetups and inventory --------------------------------------------------------------
    match /team/{name} {
      allow read: if isTechOps();
      allow update: if isTechOps() && name == me().Name;   // you can only move / re-status yourself
      allow create, delete: if false;
    }
    match /meetups/{id} {
      allow read, create, update: if isVolunteer() || signedIn();
      allow delete: if false;
    }
    match /inventory/{id} {
      allow read, update: if isTechOps();
      allow create, delete: if false;
    }
  }
}
